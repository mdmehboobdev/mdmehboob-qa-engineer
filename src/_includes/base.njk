<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ site.name }} — {{ site.title }}. {{ site.tagline }}. Available for remote QA roles and freelance contracts.">
  <meta name="keywords" content="QA Engineer, Manual Testing, Playwright Automation, API Testing, Postman, Jira, Remote QA, Software Testing, Lahore Pakistan">
  <meta name="author" content="{{ site.name }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ site.name }} — {{ site.title }}">
  <meta property="og:description" content="{{ site.tagline }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="/assets/images/photo.png">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ site.name }} — {{ site.title }}">
  <meta name="twitter:description" content="{{ site.tagline }}">

  <title>{{ title if title else site.name + ' — ' + site.title }}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

  <!-- NAV -->
  <nav class="nav" id="main-nav" role="navigation" aria-label="Main navigation">
    <a href="/" class="nav-logo">
      <img class="nav-logo-img" src="/assets/images/logo.jpg" alt="{{ site.name }} QA Logo">
      <span class="nav-logo-text">MM<em>.</em>QA</span>
    </a>
    <div class="nav-links">
      <a href="#services" data-section="services">Services</a>
      <a href="#projects" data-section="projects">Projects</a>
      <a href="#cv" data-section="cv">CV</a>
      <a href="#contact" data-section="contact">Contact</a>
    </div>
    <div class="nav-right">
      <span class="nav-open-badge">
        <span class="wa-dot" aria-hidden="true"></span>Open to work
      </span>
      <a class="nav-github" href="https://github.com/mdmehboobqaengineer/mdmehboob-qa-engineer" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a class="btn-wa" href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="Contact on WhatsApp">
        <span class="wa-dot" aria-hidden="true"></span>WhatsApp
      </a>
      <a class="btn-hire" href="#contact">Hire me</a>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main>
    {{ content | safe }}
  </main>

  <!-- FOOTER -->
  <footer role="contentinfo">
    <div class="footer-col">
      <span class="footer-name">{{ site.name }} © 2025</span>
      <span class="footer-remote">Open to remote work worldwide</span>
    </div>
    <div class="footer-status">
      <span class="footer-dot" aria-hidden="true"></span>
      Available · Lahore, PK
    </div>
    <div class="footer-links">
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/mdmehboobqaengineer/mdmehboob-qa-engineer/" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href="mailto:mdmehboobqaengineer@gmail.com">Email</a>
    </div>
  </footer>

  <script src="/assets/js/main.js"></script>
</body>
</html>
